# loxilb-oam configuration — copy to `.env` and fill in real values.
# Do NOT commit your filled-in .env. The server refuses to start if any of the
# REQUIRED secrets below are unset (there are no built-in fallback values).

# ── Required secrets (server will not start without these) ───────────────────

# JWT signing key. Use a long, random value, e.g. `openssl rand -base64 48`.
OAM_JWT_SECRET=

# Password assigned to the bootstrap admin on first run and to users created by
# configuration import. Change it after first login.
# Policy: >=9 chars w/ upper+lower+digit+special, no char 3x in a row
# (violations abort startup on a fresh install).
OAM_DEFAULT_ADMIN_PASSWORD=

# Database password (alternatively pass -db-password on the command line).
OAM_DB_PASSWORD=

# ── Docker Compose stack only ────────────────────────────────────────────────
# The bundled docker-compose.yml additionally requires the two variables below
# (the binary itself does not read them). DB_PASSWORD both provisions the
# `oamuser` account inside the bundled MySQL and is what the OAM service
# connects with — single source, so there is no separate MYSQL_PASSWORD.
# (These are the same keys the deploy/compose bundle uses.)
MYSQL_ROOT_PASSWORD=
DB_PASSWORD=

# ── Strongly recommended ─────────────────────────────────────────────────────

# Base64-encoded 32-byte AES-256 key for encrypting instance snapshots at rest.
# Generate with: `openssl rand -base64 32`
# WITHOUT this, snapshots — which contain IPsec PSKs and certificate private
# keys — are stored UNENCRYPTED in the database.
SNAPSHOT_ENC_KEY=

# Comma-separated CORS origin allowlist, e.g.
# https://oam.example.com,http://localhost:3000
# If unset, CORS allows any origin (development only).
OAM_ALLOWED_ORIGINS=

# ── Optional ─────────────────────────────────────────────────────────────────

# JWT / API-token lifetime in minutes (default 480 = 8 hours). In this Compose
# stack the knob is TOKEN_EXPIRATION (the container entrypoint maps it to
# -token-expiration). The bare binary instead reads OAM_TOKEN_TTL_MINUTES.
# TOKEN_EXPIRATION=480

# TLS for connections to managed LoxiLB instances (proxy + snapshots).
# Certificates are verified by default. Point OAM_INSTANCE_CA_BUNDLE at a PEM
# bundle to trust a private/self-signed CA. Set OAM_INSTANCE_TLS_INSECURE=true
# to skip verification (development only; logs a startup warning).
# OAM_INSTANCE_CA_BUNDLE=/etc/loxilb-oam/instance-ca.pem
# OAM_INSTANCE_TLS_INSECURE=false

# Docker Engine API used to operate instance hosts. Defaults to plaintext on
# 2375. For production, enable TLS and provide client certs (ca.pem, cert.pem,
# key.pem) in OAM_DOCKER_CERT_PATH.
# OAM_DOCKER_TLS=false
# OAM_DOCKER_PORT=2375
# OAM_DOCKER_CERT_PATH=/etc/loxilb-oam/docker-certs

# OAuth login is experimental and DISABLED by default. Set OAM_OAUTH_ENABLED=true
# to register the OAuth routes, then configure the providers below (a provider
# with empty credentials stays disabled). Redirect URLs are passed as CLI flags
# (-google-redirect-url, ...).
# OAM_OAUTH_ENABLED=false
# OAM_OAUTH_GOOGLE_CLIENT_ID=
# OAM_OAUTH_GOOGLE_CLIENT_SECRET=
# OAM_OAUTH_GITHUB_CLIENT_ID=
# OAM_OAUTH_GITHUB_CLIENT_SECRET=
# OAM_OAUTH_FACEBOOK_CLIENT_ID=
# OAM_OAUTH_FACEBOOK_CLIENT_SECRET=

# ── Database connection ──────────────────────────────────────────────────────
# Compose stack: honored via docker-compose.yml (DB_HOST defaults to the bundled
# `mysql` service). Override only for an external DB. When running the bare
# binary, pass -db-user/-db-host/-db-port/-db-name instead.
# DB_USER=oamuser
# DB_HOST=mysql
# DB_PORT=3306
# DB_NAME=loxioam
