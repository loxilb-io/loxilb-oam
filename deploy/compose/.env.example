# LoxiLB management-plane bundle — configuration.
# Copy to `.env` and fill in. The same key names map 1:1 to the k8s
# ConfigMap/Secret. Never commit your filled-in .env.

# ── Required secrets (stack refuses to start without these) ──────────────────
MYSQL_ROOT_PASSWORD=
# DB_PASSWORD provisions the oamuser account in the bundled MySQL AND is what the
# OAM service connects with — single source, so there is no separate MYSQL_PASSWORD.
DB_PASSWORD=
OAM_JWT_SECRET=                 # e.g. `openssl rand -base64 48`
OAM_DEFAULT_ADMIN_PASSWORD=     # bootstrap admin; change after first login.
                                # Policy: >=9 chars w/ upper+lower+digit+special,
                                # no char 3x in a row (violations abort startup
                                # on a fresh install — docs/deployment-compose.md §3)

# ── Strongly recommended ─────────────────────────────────────────────────────
# Base64 32-byte AES key: `openssl rand -base64 32`. Without it, instance
# snapshots (IPsec PSKs + cert private keys) are stored UNENCRYPTED.
SNAPSHOT_ENC_KEY=
# CORS allowlist, e.g. https://oam.example.com. Unset => wildcard (dev only).
OAM_ALLOWED_ORIGINS=
# Proxy IPs/CIDRs whose X-Forwarded-For OAM will believe. Compose defaults this
# to Docker's bridge pool (172.16.0.0/12) so the Caddy edge's forwarded client
# IP is honoured — rate limiting and login lockout key on it. Set only if your
# network differs; never widen it to include untrusted callers.
OAM_TRUSTED_PROXIES=

# ── Edge (browser → UI/OAM) TLS — two knobs, one Caddyfile ───────────────────
# Two first-class modes (see README); the rest are supported variants.
#
#   ★ Dev mode — end-to-end HTTP (the shipped default):
#     SITE_ADDRESS=:80
#     EDGE_TLS=
#
#   ★ Prod mode — end-to-end HTTPS, self-signed edge cert:
#     run scripts/generate-edge-certs.sh <hostname>  then:
#     SITE_ADDRESS=https://your.host
#     EDGE_TLS=tls /certs/edge/cert.pem /certs/edge/key.pem
#
#   Variant — self-signed, zero-file (quick dev, Caddy local CA):
#     SITE_ADDRESS=https://localhost
#     EDGE_TLS=tls internal
#
#   Variant — automatic HTTPS (public DNS reachable from the host):
#     SITE_ADDRESS=your.public.domain
#     EDGE_TLS=
#
#   Variant — official / commercial cert: drop cert.pem+key.pem in certs/edge/
#     SITE_ADDRESS=https://your.domain
#     EDGE_TLS=tls /certs/edge/cert.pem /certs/edge/key.pem
SITE_ADDRESS=:80
EDGE_TLS=
HTTP_PORT=80
HTTPS_PORT=443
# Reaching the edge by IP (https://203.0.113.10) instead of by name? TLS cannot
# carry an IP in SNI, so those clients send none, and Caddy — which picks its
# TLS policy by SNI — refuses the handshake with alert 80. Adding the IP to
# SITE_ADDRESS does NOT fix it. Set the SNI to fall back to:
#     EDGE_SNI_FALLBACK=default_sni your.host
# An IP works here too (verified), so a node with NO DNS name at all is fine:
#     SITE_ADDRESS=https://203.0.113.10:8443
#     EDGE_SNI_FALLBACK=default_sni 203.0.113.10
# For that case the certificate must carry an IP: SAN, and EDGE_TLS must name a
# cert file — ACME cannot issue for a private address. Generate one with:
#     scripts/generate-edge-certs.sh 203.0.113.10
# (the script emits IP: SANs automatically when given an address).
# Leave empty when every client connects by hostname.
EDGE_SNI_FALLBACK=

# Fixed intra-stack upstream (byte-identical to the k8s Service URL).
OAM_UPSTREAM=http://oam-loxilb:8080

# ── TLS to managed LoxiLB instances (OAM → data plane) ───────────────────────
# Production: run scripts/generate-instance-certs.sh <host>, start loxilb with
# --tls, register instances as https://<host>:8091/netlox/v1, and point OAM at
# the CA below (verification ON). Development: set OAM_INSTANCE_TLS_INSECURE=true.
OAM_INSTANCE_CA_BUNDLE=
# OAM_INSTANCE_CA_BUNDLE=/etc/loxilb-oam/certs/instance-ca.pem
OAM_INSTANCE_TLS_INSECURE=false

# ── Converged single-node mode (gateway co-located on this host) ─────────────
# Only needed for docker-compose.converged.yml + docker-compose.dataplane.yml.
# Full guide:
# docs/deployment-converged.md. Leave this whole section empty otherwise.
#
# The gateway runs in the HOST network namespace, so it has no compose DNS name.
# GW_HOST is the name OAM registers it under and the SAN on its certificate —
# use a real hostname for this node, then:
#     scripts/generate-instance-certs.sh $GW_HOST
#     register the instance as https://$GW_HOST:8091/netlox/v1
# The converged overlay pins that name to the Docker host-gateway address, so
# the call reaches the local gateway without leaving the bridge.
GW_HOST=

# Edge binding. On a converged node the data plane wants 80/443 for inference
# VIPs, so the management edge publishes HTTPS only, on a port of its own, bound
# to ONE address rather than the wildcard. Set SITE_ADDRESS to match, INCLUDING
# the port, or Caddy's site block will not match the browser's Host header:
#     SITE_ADDRESS=https://oam.example.internal:8443
#     EDGE_TLS=tls /certs/edge/cert.pem /certs/edge/key.pem
# NOTE: moving off :80/:443 removes the ports ACME needs (HTTP-01 wants :80,
# TLS-ALPN-01 wants :443). An already-issued cert keeps serving and then fails
# to RENEW — months later, silently. Use an operator-supplied cert here, or keep
# the edge on :443 and put VIPs on a secondary address. See the doc's
# "Converged port-split breaks ACME renewal".
EDGE_BIND_IP=            # e.g. 192.168.0.8 — the management address. Empty = 0.0.0.0 (all)
EDGE_HTTPS_PORT=8443

# Host endpoints no load-balancer rule may claim, comma-separated ip:port[/proto].
# Set this to whatever the edge above binds. It matters most on a SINGLE-NIC
# host: the gateway's eBPF datapath sits on the same wire as management traffic
# and an L4 rule on the edge address:port is handled ahead of netfilter, so it
# would swallow the console silently — no bind error, nothing logged. OAM
# refuses such a rule with 409. A malformed value here aborts startup, because a
# guard that silently failed to parse is worse than no guard.
# NOTE: this covers rules created THROUGH OAM. Keep the gateway's own API
# unreachable from elsewhere (see IGW_TLS_HOST) so OAM is the only way in.
OAM_RESERVED_ENDPOINTS=  # e.g. 192.168.0.8:8443

# Gateway container (docker-compose.dataplane.yml — a SEPARATE compose project,
# so a management-plane `down` cannot drop live traffic).
IGW_IMAGE=ghcr.io/loxilb-io/loxilb-inference-gateway
IGW_TAG=                 # pin to a released version; latest-u24 for Ubuntu 24.04 hosts
IGW_CONFIG_DIR=/opt/loxilb/config   # host path for snapshot.json — MUST persist
# Address for the gateway's verified-TLS management API (:8091). 0.0.0.0 keeps
# it reachable from the LAN; narrow it, or firewall the port, so that OAM is the
# only client. The plaintext :11111 API is pinned to loopback regardless.
IGW_TLS_HOST=0.0.0.0

# ── Database ─────────────────────────────────────────────────────────────────
DB_USER=oamuser
DB_HOST=mysql          # `mysql` = bundled DB; set a hostname for an external DB
DB_PORT=3306
DB_NAME=loxioam
TOKEN_EXPIRATION=480   # JWT lifetime, minutes

# ── Images (prod pins these; dev builds from source instead) ─────────────────
OAM_IMAGE=ghcr.io/loxilb-io/loxilb-oam
UI_IMAGE=ghcr.io/loxilb-io/loxilb-ui
OAM_TAG=latest         # prod: pin to a released version, e.g. v0.9.8.7
UI_TAG=latest          # prod: pin to a released version

# ── Dev-only knobs (source build contexts, debug host ports) ─────────────────
# OAM_SRC=../..
# OAM_HOST_PORT=8080
# MYSQL_HOST_PORT=3306
# Release stamped into an OAM image built from source (dev overlay). Unset, a
# source build honestly reports "dev" from `loxilb-oam -version`. The console
# image is pulled, not built — pin it with UI_IMAGE / UI_TAG above.
# OAM_VERSION=v0.9.8.7

# ── DB init (schema source) ──────────────────────────────────────────────────
# Defaults to the OAM repo's database/init. Point elsewhere only if this bundle
# is relocated away from loxilb-oam/deploy/compose/.
# DB_INIT_DIR=../../database/init
