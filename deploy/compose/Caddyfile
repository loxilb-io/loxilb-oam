# LoxiLB edge — serves the SPA, proxies the OAM API, terminates edge TLS.
#
# Two env knobs drive every TLS mode (values come from compose → .env):
#   SITE_ADDRESS : what to listen on   (":80" | "https://host" | "host")
#   EDGE_TLS     : how to get the cert (""=ACME | "tls internal" | "tls <crt> <key>")
# See the deployment plan §6.4 for the mode table.

{
	admin off

	# SNI has no representation for IP literals, so a browser opened at
	# https://<ip> sends NO SNI at all — listing the IP in SITE_ADDRESS does
	# not help, because Caddy selects its TLS connection policy by SNI. An
	# SNI-less ClientHello then matches no site and the handshake dies with
	# alert 80 (internal_error), before a single byte of HTTP is spoken — which
	# is why it presents as "the port is closed" rather than as a TLS problem.
	#
	# Set EDGE_SNI_FALLBACK=default_sni <your.host> when operators reach the
	# edge by IP; empty (the default) is correct for name-only access.
	{$EDGE_SNI_FALLBACK}
}

{$SITE_ADDRESS} {
	# Empty → automatic HTTPS (ACME) when SITE_ADDRESS is a public domain, or
	# plain HTTP when SITE_ADDRESS is ":80". Otherwise this line becomes
	# "tls internal" (Caddy local CA) or "tls /certs/edge/cert.pem /certs/edge/key.pem".
	{$EDGE_TLS}

	encode gzip zstd

	# OAM API: /api/oam/* → strip that prefix, forward as /oam/* to the API.
	# (Matches the legacy nginx mapping: /api/oam/ → ${BACKEND}/oam/.)
	handle_path /api/oam/* {
		rewrite * /oam{uri}
		reverse_proxy {$OAM_UPSTREAM} {
			header_up X-Forwarded-Proto {scheme}
			header_up X-Real-IP {remote_host}
		}
	}

	# Edge liveness (distinct from OAM's /oam/health).
	handle /healthz {
		respond "ok" 200
	}

	# Bare root → the app's public prefix (React Router basename = /netlox).
	redir / /netlox/ 302

	# SPA: root-relative assets (/static, /favicon.ico, /manifest.json) are real
	# files; everything else (e.g. /netlox/dashboard) falls back to index.html
	# so client-side routing works.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
